# ===== SportMonks API =====
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here

# ===== PostgreSQL =====
POSTGRES_USER=killua
POSTGRES_PASSWORD=killua_secret
POSTGRES_DB=killuafootball
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Local dev: localhost | Docker: postgres (service name)
DATABASE_URL="postgresql://killua:killua_secret@localhost:5432/killuafootball"

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== Next.js =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===== Python Model Service =====
# Local dev: localhost | Docker: python-model-service (service name)
MODEL_SERVICE_URL=http://localhost:8000
MODEL_ARTIFACTS_PATH=./python/models

# ===== App Secrets =====
APP_SECRET=change_this_to_a_random_secret_key
ADMIN_SECRET=change_this_to_admin_secret
API_KEY=change_this_to_a_strong_api_key_for_custom_gpt
