# ===== SportMonks API =====
# ⚠️ REQUIRED: Get your token from sportmonks.com dashboard
SPORTMONKS_API_TOKEN=your_sportmonks_api_token_here

# ===== PostgreSQL =====
POSTGRES_USER=killua
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=killuafootball
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://killua:CHANGE_ME_strong_password@postgres:5432/killuafootball"

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ===== Next.js =====
NEXT_PUBLIC_APP_URL=http://YOUR_SERVER_IP
NODE_ENV=production

# ===== Python Model Service =====
MODEL_SERVICE_URL=http://python-model-service:8000
MODEL_ARTIFACTS_PATH=./python/models

# ===== App Secrets =====
# ⚠️ REQUIRED: Generate strong random secrets (e.g. openssl rand -hex 32)
APP_SECRET=CHANGE_ME_random_secret
ADMIN_SECRET=CHANGE_ME_admin_secret
API_KEY=CHANGE_ME_api_key_for_custom_gpt
